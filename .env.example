DATABASE_URL=sqlite:///./jobops.db
JOBOPS_AUTO_SUBMIT=false
JOBOPS_FRESH_PREFERRED_HOURS=24
JOBOPS_FRESH_MAX_HOURS=48
LOG_LEVEL=INFO

# Optional overrides; defaults resolve from the repository layout.
# JOBOPS_CANDIDATE_PROFILE_PATH=/absolute/path/to/verified_profile.json
# JOBOPS_ANSWER_BANK_PATH=/absolute/path/to/answer_bank.json
# JOBOPS_RESUMES_DIR=/absolute/path/to/resumes

# Future integrations:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REDIS_URL=
# BLOB_STORAGE_CONNECTION=
