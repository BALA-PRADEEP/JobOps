DATABASE_URL=sqlite:///./jobops.db
JOBOPS_AUTO_SUBMIT=false
JOBOPS_EXECUTION_MODE=queued
JOBOPS_FRESH_PREFERRED_HOURS=24
JOBOPS_FRESH_MAX_HOURS=48
JOBOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production candidate data must be injected as a secret, not committed.
# JOBOPS_CANDIDATE_PROFILE_B64=

# Worker-only:
# JOBOPS_RESUMES_DIR=/private/resumes
# JOBOPS_ARTIFACT_DIR=/tmp/jobops-artifacts
# JOBOPS_WORKER_LIMIT=3
